rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasUserRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    // Role Enforcement: Only Firestore users/{uid}.data.role == 'admin' grants admin privileges
    function isAdmin() {
      return hasUserRole('admin');
    }

    function isEditorOrAdmin() {
      return isAdmin() || hasUserRole('editor');
    }

    function isValidCounterIncrement(fieldName) {
      let isFirstInit = !(fieldName in resource.data) && request.resource.data[fieldName] == 1;
      let isIncrementByOne = (fieldName in resource.data)
        && resource.data[fieldName] is number
        && request.resource.data[fieldName] is number
        && request.resource.data[fieldName] == resource.data[fieldName] + 1;
      return isFirstInit || isIncrementByOne;
    }

    // Helper function: Ensures ONLY the specified field is being modified in the document
    function isOnlyModifying(fieldName) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([fieldName]);
    }

    function isValidCounterUpdate() {
      return (isOnlyModifying('viewCount') && isValidCounterIncrement('viewCount'))
        || (isOnlyModifying('downloadCount') && isValidCounterIncrement('downloadCount'));
    }

    // ============================================================
    // EXAM LIBRARY & PAPERS SECURITY RULES
    // ============================================================
    match /exams/{examId} {
      allow read: if true;
      allow write: if false;

      match /years/{yearId} {
        allow read: if true;
        allow write: if false;

        match /papers/{paperId} {
          allow read: if true;

          // STRICT COUNTER UPDATE ENFORCEMENT:
          allow update: if 
            (isOnlyModifying('viewCount') && isValidCounterIncrement('viewCount')) ||
            (isOnlyModifying('downloadCount') && isValidCounterIncrement('downloadCount'));

          allow create, delete: if false;

          match /questions/{questionId} {
            allow read: if true;
            allow write: if false;
          }
        }
      }
    }

    // ============================================================
    // STUDY RESOURCES SECURITY RULES
    // ============================================================
    match /studyResources/{examId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isValidCounterUpdate();

      match /subjects/{subjectId} {
        allow read: if true;
        allow create, update, delete: if isEditorOrAdmin();

        match /chapters/{chapterId} {
          allow read: if resource.data.status == 'published' || isEditorOrAdmin();
          allow create, delete: if isEditorOrAdmin();
          allow update: if isEditorOrAdmin() || isValidCounterUpdate();
        }
      }
    }

    // ============================================================
    // USER ACCOUNTS & ROLE ESCALATION PROTECTION
    // ============================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // Ordinary user sign-up MUST be role == 'user', matching uid, and no admin elevation fields
      allow create: if isOwner(userId)
        && request.resource.data.role == 'user'
        && request.resource.data.uid == userId
        && !('isAdmin' in request.resource.data);
      // Ordinary users CANNOT change their role or set role to admin; uid is protected
      allow update: if (
        isOwner(userId)
        && (!('uid' in request.resource.data) || request.resource.data.uid == userId)
        && (!('uid' in request.resource.data) || !('uid' in resource.data) || request.resource.data.uid == resource.data.uid)
        && (('role' in resource.data && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)) || (!('role' in resource.data) && (!('role' in request.resource.data) || request.resource.data.role == 'user')))
        && (!('role' in request.resource.data) || request.resource.data.role != 'admin')
        && !('isAdmin' in request.resource.data)
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // Sensitive collections - completely protected from client writes
    match /adminRoles/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Contact form abuse protection: validate field whitelist, types, lengths, and initial status
    match /contacts/{contactId} {
      allow create: if request.resource.data.keys().hasOnly(['userId', 'name', 'email', 'message', 'status', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() > 3 && request.resource.data.email.size() <= 150
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
        && request.resource.data.status == 'new'
        && request.resource.data.userId is string && request.resource.data.userId.size() <= 128
        && (request.resource.data.createdAt is timestamp);
      allow read, update, delete: if isAdmin();
    }

    // ============================================================
    // UNIVERSAL MOCK TEST & IMPORT PIPELINE SECURITY RULES
    // ============================================================
    match /examConfigs/{configId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /mockTests/{testId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }

    match /mockQuestions/{questionId} {
      // MANDATORY SECURITY GATE: Direct client reads denied for ordinary students.
      // Published test questions are served exclusively via the Express backend API (/api/mock-tests/:testId)
      // which verifies publication status and strips confidential answer keys.
      allow read, write: if isAdmin();
    }

    match /mockAnswerKeys/{answerKeyId} {
      // MANDATORY SECURITY GATE: Protected Answer Keys are NEVER readable or writable by clients!
      // Only the Server Backend (Service Account) can access them.
      allow read, write: if false;
    }

    match /mockAttempts/{attemptId} {
      // Attempts are managed strictly by the Express backend API (/api/mock-tests/attempts/*)
      // using server-authoritative timers, deadlines, and state transitions.
      // Students may read their own attempts; direct client writes are forbidden.
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /mockResults/{resultId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /paperImportJobs/{jobId} {
      allow read, write: if isAdmin();
    }
  }
}

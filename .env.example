# ============================================================
# VIDYARTHIVERSE - AI CHATBOT & WEB SEARCH ENVIRONMENT CONFIGURATION
# ============================================================

# Firebase / Firestore server access
FIREBASE_PROJECT_ID=your-firebase-project-id
# Required for protected mock-test questions, attempts, and authenticated role lookups.
# Keep this credential file out of source control; serviceAccountKey*.json is gitignored.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Primary AI Provider (Default: groq)
AI_PROVIDER=groq

# Groq API Key (Get your key at https://console.groq.com/keys)
AI_API_KEY=PASTE_YOUR_GROQ_API_KEY_HERE
GROQ_API_KEY=PASTE_YOUR_GROQ_API_KEY_HERE

# Groq AI Model (Supported options: openai/gpt-oss-120b, llama-3.3-70b-versatile, etc.)
AI_MODEL=openai/gpt-oss-120b

# Groq OpenAI-compatible Base URL
AI_BASE_URL=https://api.groq.com/openai/v1

# Web Search Provider Configuration (TinyFish Primary + Serper Google Search Fallback)
SEARCH_PROVIDER=tinyfish
SEARCH_FALLBACK_ENABLED=true
SEARCH_TIMEOUT_MS=10000
FETCH_TIMEOUT_MS=15000
SEARCH_MAX_RESULTS=10
SEARCH_RATE_LIMIT_PER_MINUTE=10

# TinyFish Configuration (Primary Web Discovery & Fetch Provider)
TINYFISH_API_KEY=PASTE_YOUR_TINYFISH_API_KEY_HERE
TINYFISH_SEARCH_URL=https://api.search.tinyfish.ai
TINYFISH_FETCH_URL=https://api.fetch.tinyfish.ai

# Serper Configuration (Secondary Fallback Provider - https://serper.dev)
SERPER_API_KEY=PASTE_YOUR_SERPER_API_KEY_HERE
SERPER_SEARCH_URL=https://google.serper.dev/search

# Live Updates Request & Budget Control Limits
LIVE_UPDATES_MAX_SEARCHES=20
LIVE_UPDATES_MAX_FETCH_URLS=8

# Server & Chatbot Limits
PORT=3000
AI_TEMPERATURE=0.35
AI_MAX_TOKENS=1200
MAX_MESSAGE_LENGTH=1000
MAX_CHAT_MESSAGES=10
DAILY_MESSAGE_LIMIT=20
LIVE_UPDATES_CACHE_TTL_MINUTES=20
LIVE_UPDATES_RATE_LIMIT_PER_MINUTE=5



